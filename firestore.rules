rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /Users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.Email is string && request.resource.data.Username is string && request.resource.data.uid == request.auth.uid;
    }

    match /categories/{categoryId} {
      function isCategoryOwner() {
        return resource.data.userId == request.auth.uid;
      }

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.name is string;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isCategoryOwner() && request.resource.data.userId == request.auth.uid && request.resource.data.name is string;
      allow delete: if isSignedIn() && isCategoryOwner();

      match /note/{noteId} {
        function isNoteOwner() {
          return resource.data.userId == request.auth.uid;
        }

        allow create: if isSignedIn() && get(/databases/$(database)/documents/categories/$(categoryId)).data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.note is string;
        allow read: if isSignedIn() && get(/databases/$(database)/documents/categories/$(categoryId)).data.userId == request.auth.uid && resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && isNoteOwner() && get(/databases/$(database)/documents/categories/$(categoryId)).data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.note is string;
        allow delete: if isSignedIn() && isNoteOwner() && get(/databases/$(database)/documents/categories/$(categoryId)).data.userId == request.auth.uid;
      }
    }
  }
}
